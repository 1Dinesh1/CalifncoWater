rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verify user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role-based admin check: document must exist in 'admins' collection with doc ID matching auth UID
    // Zero-compute cost, 100% free tier, strictly prevents arbitrary customers from gaining admin access
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Dealer authorization check: document must exist in 'dealers' collection with status == 'approved'
    // Prevents unapproved or regular customers from claiming wholesale pricing or wholesale order status
    function isApprovedDealer() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/dealers/$(request.auth.uid))
        && get(/databases/$(database)/documents/dealers/$(request.auth.uid)).data.status == 'approved';
    }

    // -------------------------------------------------------------
    // Administrators Registry Collection
    // -------------------------------------------------------------
    match /admins/{adminId} {
      // Authenticated users can check only their own admin status
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      // Deny client writes entirely (only manageable via Firebase Console by project owner)
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Dealer Applications & Registry Collection
    // -------------------------------------------------------------
    match /dealers/{dealerId} {
      // Dealers can read their own application status; Admins can read all dealer applications
      allow read: if isAuthenticated() && (request.auth.uid == dealerId || isAdmin());

      // Authenticated users can submit a dealer application strictly for their own UID
      allow create: if isAuthenticated()
        // Ownership verification: doc ID and userId must match request.auth.uid
        && request.auth.uid == dealerId
        && request.resource.data.userId == request.auth.uid
        // Enforce required fields
        && request.resource.data.keys().hasAll([
          'userId', 'email', 'businessName', 'phone', 'city',
          'status', 'createdAt'
        ])
        // Field whitelist: reject unexpected fields (optional gstNumber permitted)
        && request.resource.data.keys().hasOnly([
          'userId', 'email', 'businessName', 'phone', 'city',
          'gstNumber', 'status', 'createdAt'
        ])
        // Data type validation
        && request.resource.data.email is string
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && (!('gstNumber' in request.resource.data) || request.resource.data.gstNumber is string)
        // Enforce initial status: must be 'pending' (prevent self-approval)
        && request.resource.data.status == 'pending'
        // Server timestamp enforcement
        && request.resource.data.createdAt == request.time;

      // Only verified administrators can update, and ONLY the status field to valid enum values
      allow update: if isAdmin()
        // Enforce affected keys allowlist: only 'status' can be changed
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        // Enforce valid status values
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        // Ensure all immutable dealer application details remain strictly identical
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.businessName == resource.data.businessName
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.city == resource.data.city
        && request.resource.data.createdAt == resource.data.createdAt;

      // Deletions are completely denied
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Customer Orders Collection
    // -------------------------------------------------------------
    match /orders/{orderId} {
      // Customers read their own orders; Admins can read all orders
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Customers can create orders strictly for their own UID
      allow create: if isAuthenticated()
        // Ownership verification: doc must be created for the authenticated user
        && request.resource.data.userId == request.auth.uid
        // Enforce required fields present on all orders
        && request.resource.data.keys().hasAll([
          'userId', 'customerEmail', 'customerPhone', 'deliveryAddress',
          'items', 'totalItems', 'totalAmount', 'orderStatus',
          'paymentMethod', 'paymentStatus', 'createdAt'
        ])
        // Field whitelist: reject unexpected or injected attributes (permitting optional wholesale fields)
        && request.resource.data.keys().hasOnly([
          'userId', 'customerEmail', 'customerName', 'customerPhone',
          'deliveryAddress', 'items', 'totalItems', 'totalAmount',
          'orderStatus', 'paymentMethod', 'paymentStatus', 'createdAt',
          'orderType', 'businessName'
        ])
        // Customer contact & shipping data type validation
        && request.resource.data.customerEmail is string
        && request.resource.data.customerPhone is string
        && (request.resource.data.deliveryAddress is string || request.resource.data.deliveryAddress is map)
        && (!('customerName' in request.resource.data) || request.resource.data.customerName is string)
        // Item list & positive quantity/amount enforcement
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.totalItems is int
        && request.resource.data.totalItems > 0
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0
        // Order type authorization:
        // Retail orders: orderType omitted or 'retail', no wholesale privileges claimed
        // Wholesale orders: strictly requires verified approved dealer and matching registered businessName
        && (
          (
            (!('orderType' in request.resource.data) || request.resource.data.orderType == 'retail')
            && (!('businessName' in request.resource.data) || request.resource.data.businessName is string)
          )
          ||
          (
            request.resource.data.orderType == 'wholesale'
            && isApprovedDealer()
            && ('businessName' in request.resource.data)
            && request.resource.data.businessName is string
            && request.resource.data.businessName == get(/databases/$(database)/documents/dealers/$(request.auth.uid)).data.businessName
          )
        )
        // Initial order lifecycle & payment validation: Cash on Delivery only
        && request.resource.data.orderStatus == 'placed'
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.createdAt == request.time;

      // Only verified administrators can update, and ONLY the orderStatus field to valid enum values
      allow update: if isAdmin()
        // Enforce affected keys allowlist: only 'orderStatus' can be changed
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus'])
        // Enforce valid status values matching frontend application options
        && request.resource.data.orderStatus in ['placed', 'confirmed', 'dispatched', 'delivered', 'cancelled']
        // Ensure all immutable order & customer attributes remain strictly identical
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.customerEmail == resource.data.customerEmail
        && request.resource.data.customerPhone == resource.data.customerPhone
        && request.resource.data.deliveryAddress == resource.data.deliveryAddress
        && request.resource.data.items == resource.data.items
        && request.resource.data.totalItems == resource.data.totalItems
        && request.resource.data.totalAmount == resource.data.totalAmount
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('customerName' in resource.data) || request.resource.data.customerName == resource.data.customerName)
        && (!('orderType' in resource.data) || request.resource.data.orderType == resource.data.orderType)
        && (!('businessName' in resource.data) || request.resource.data.businessName == resource.data.businessName);

      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Customer Service Bookings Collection
    // -------------------------------------------------------------
    match /serviceBookings/{bookingId} {
      // Customers read their own bookings; Admins can read all bookings
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Customers can create bookings strictly for their own UID
      allow create: if isAuthenticated()
        // Enforce required fields
        && request.resource.data.keys().hasAll([
          'userId', 'customerEmail', 'customerPhone', 'serviceType',
          'preferredDate', 'preferredSlot', 'address', 'bookingStatus',
          'createdAt'
        ])
        // Reject unexpected fields
        && request.resource.data.keys().hasOnly([
          'userId', 'customerEmail', 'customerName', 'customerPhone',
          'serviceType', 'preferredDate', 'preferredSlot', 'address',
          'notes', 'bookingStatus', 'createdAt'
        ])
        // Ownership verification
        && request.resource.data.userId == request.auth.uid
        // Data type validation
        && request.resource.data.customerEmail is string
        && request.resource.data.customerPhone is string
        && request.resource.data.serviceType is string
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredSlot is string
        && request.resource.data.address is string
        && (!('customerName' in request.resource.data) || request.resource.data.customerName is string)
        && (!('notes' in request.resource.data) || request.resource.data.notes is string)
        // Enforce initial booking status
        && request.resource.data.bookingStatus == 'requested'
        && request.resource.data.createdAt == request.time;

      // Only verified administrators can update, and ONLY the bookingStatus field to valid enum values
      allow update: if isAdmin()
        // Enforce affected keys allowlist: only 'bookingStatus' can be changed
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus'])
        // Enforce valid status values matching frontend application options
        && request.resource.data.bookingStatus in ['requested', 'confirmed', 'completed', 'cancelled']
        // Ensure all immutable booking & customer attributes remain strictly identical
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.customerEmail == resource.data.customerEmail
        && request.resource.data.customerPhone == resource.data.customerPhone
        && request.resource.data.serviceType == resource.data.serviceType
        && request.resource.data.preferredDate == resource.data.preferredDate
        && request.resource.data.preferredSlot == resource.data.preferredSlot
        && request.resource.data.address == resource.data.address
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Referral Attributions Collection
    // -------------------------------------------------------------
    match /referrals/{referralId} {
      // Users can read their own referral attribution; Admins can read all referrals
      allow read: if isAuthenticated() && (resource.data.referredUserId == request.auth.uid || isAdmin());

      // Newly registered users can create an attribution document for themselves
      allow create: if isAuthenticated()
        // Ownership verification: referredUserId must match request.auth.uid
        && request.resource.data.referredUserId == request.auth.uid
        // Prevent self-referral: the referral code cannot contain the user's own UID snippet
        && !request.resource.data.referralCode.matches('.*' + request.auth.uid.upper() + '.*')
        // Enforce required fields
        && request.resource.data.keys().hasAll([
          'referredUserId', 'referredUserEmail', 'referralCode', 'attributedAt', 'serverTimestamp'
        ])
        // Enforce field whitelist
        && request.resource.data.keys().hasOnly([
          'referredUserId', 'referredUserEmail', 'referralCode', 'attributedAt', 'serverTimestamp'
        ])
        // Data type validation
        && request.resource.data.referredUserId is string
        && request.resource.data.referredUserEmail is string
        && request.resource.data.referralCode is string
        && request.resource.data.referralCode.matches('^CALIF-[A-Z0-9]{4,10}$')
        && request.resource.data.attributedAt is string
        && request.resource.data.serverTimestamp == request.time;

      // Immutability: Referrals cannot be altered once created
      allow update: if false;

      // Referral attributions cannot be deleted by clients
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Default Deny: Deny all access to any unspecified collection
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
